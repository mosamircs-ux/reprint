<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BioPulse" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/bp_primary</item>
        <item name="colorOnPrimary">@color/bp_on_primary</item>
        <item name="colorSecondary">@color/bp_secondary</item>
        <item name="android:colorBackground">@color/bp_background</item>
        <item name="colorSurface">@color/bp_surface</item>
        <item name="colorOnSurface">@color/bp_text_primary</item>
        <item name="colorOutline">@color/bp_stroke</item>
        <item name="android:statusBarColor">@color/bp_background</item>
        <item name="android:navigationBarColor">@color/bp_background</item>
    </style>

    <style name="BioPulseCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/bp_surface</item>
        <item name="strokeColor">@color/bp_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="BioPulseChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1.2dp</item>
        <item name="android:textColor">@color/bp_text_primary</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>

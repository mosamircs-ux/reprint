<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bp_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Verified • BiometricPrompt" />

        <TextView
            android:id="@+id/tvHistoryDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/bp_text_secondary"
            android:textSize="11sp"
            tools:text="14:05:12 • Authenticated cleanly" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryLatency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/bp_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="230 ms" />

</LinearLayout>
